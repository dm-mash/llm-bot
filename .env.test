# Test-only configuration. Loaded by tests/conftest.py (with override=True)
# BEFORE any real .env is consulted, so actual secrets never leak into tests.
#
# These are neutral/dummy values. Tests that need specific credentials build
# their own LLMConfig explicitly; this file just keeps the environment clean.

LLM_BASE_URL=https://test.local/v1
LLM_API_KEY=test-key
LLM_MODEL=test-model

GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CLIENT_ID=client-123
GIGACHAT_CLIENT_SECRET=secret-abc
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Deliberately empty so _oauth_authorization() falls back to client_id/secret.
GIGACHAT_BASIC_AUTH=