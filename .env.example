# Copy this file to `.env` and fill in your values.
#
# The client is provider-agnostic: it speaks the OpenAI-compatible
# /v1/chat/completions endpoint, so it works with OpenAI, Ollama
# (http://localhost:11434/v1), LM Studio, LocalAI, and many others.

# Base URL of the OpenAI-compatible API (include /v1 if the provider needs it).
# Examples:
#   https://api.openai.com/v1
#   http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# API key. Leave empty for local providers that don't require auth (e.g. Ollama).
LLM_API_KEY=

# Model identifier to use.
# Examples: gpt-4o-mini, llama3.2, qwen2.5 ...
LLM_MODEL=gpt-4o-mini

# Number of times to retry transient failures (timeouts, transport errors, 5xx, 429).
LLM_MAX_RETRIES=3

# Base delay (seconds) used by exponential backoff between retries.
LLM_RETRY_BACKOFF=1.0

# Request timeout in seconds.
LLM_TIMEOUT=30

# Target maximum length of the reply, in words. When set, a briefness
# instruction is added to the system prompt (soft limit enforced by the model).
# Leave empty for no limit.
LLM_MAX_RESPONSE_WORDS=

# Optional system prompt sent before the user prompt. Use it to describe the
# desired response format, e.g. require strict JSON with a specific schema.
# Example:
#   LLM_SYSTEM_PROMPT=Ответ должен быть строго в формате JSON со схемой {"answer": string}
LLM_SYSTEM_PROMPT=

# Optional BASE system prompt that is ALWAYS prepended to any other system prompt
# (LLM_SYSTEM_PROMPT, expert roles in scripts/compare_methods.py, etc.). Use it
# for global behavior. Leave empty to disable.
# Recommended default so the model always answers in the language of the request:
LLM_DEFAULT_SYSTEM_PROMPT=Отвечай на том же языке, на котором написан запрос пользователя. Не переключай язык без необходимости.

# -----------------------------------------------------------------------------
# GigaChat (Sber) — used when running with --provider gigachat.
#
# GigaChat is OpenAI-compatible, but requires an OAuth2 token exchange first:
#   1. Your client_id + client_secret are exchanged for an access token.
#   2. That token (valid ~30 min) is cached and auto-refreshed by the client.
#
# Point LLM_BASE_URL at GigaChat's chat endpoint and set the model, e.g.:
#   LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
#   LLM_MODEL=GigaChat-2-Max
# -----------------------------------------------------------------------------

# OAuth2 token endpoint (usually no need to change).
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Credentials from your GigaChat app (client_secret flow).
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# OAuth scope (defaults to GIGACHAT_API_PERS for personal use).
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Optional pre-encoded "Basic ..." value if your provider variant needs a
# different credential instead of client_id:client_secret. Leave empty normally.
GIGACHAT_BASIC_AUTH=